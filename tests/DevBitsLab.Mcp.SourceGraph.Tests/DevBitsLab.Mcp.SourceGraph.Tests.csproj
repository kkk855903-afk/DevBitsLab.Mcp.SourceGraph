<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Roslyn's xml doc helpers occasionally pull XmlException through; tests use cref-rich
         summaries so this isn't a concern. -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="coverlet.collector">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DevBitsLab.Mcp.SourceGraph.Core\DevBitsLab.Mcp.SourceGraph.Core.csproj" />
    <ProjectReference Include="..\..\src\DevBitsLab.Mcp.SourceGraph.Storage\DevBitsLab.Mcp.SourceGraph.Storage.csproj" />
    <ProjectReference Include="..\..\src\DevBitsLab.Mcp.SourceGraph.Indexing\DevBitsLab.Mcp.SourceGraph.Indexing.csproj" />
    <ProjectReference Include="..\..\src\DevBitsLab.Mcp.SourceGraph.Indexing.Xaml\DevBitsLab.Mcp.SourceGraph.Indexing.Xaml.csproj" />
    <ProjectReference Include="..\..\src\DevBitsLab.Mcp.SourceGraph.Indexing.TreeSitter\DevBitsLab.Mcp.SourceGraph.Indexing.TreeSitter.csproj" />
    <ProjectReference Include="..\..\src\DevBitsLab.Mcp.SourceGraph.Indexing.TypeScript\DevBitsLab.Mcp.SourceGraph.Indexing.TypeScript.csproj" />
    <ProjectReference Include="..\..\src\DevBitsLab.Mcp.SourceGraph.Embeddings\DevBitsLab.Mcp.SourceGraph.Embeddings.csproj" />
    <ProjectReference Include="..\..\src\DevBitsLab.Mcp.SourceGraph.Sdk\DevBitsLab.Mcp.SourceGraph.Sdk.csproj" />
    <ProjectReference Include="..\..\src\DevBitsLab.Mcp.SourceGraph.Server\DevBitsLab.Mcp.SourceGraph.Server.csproj" />
  </ItemGroup>

  <!-- Fixture build dependency. DiagnosticsAndGeneratorTests opens tests/fixtures/Sample.sln via
       MSBuildWorkspace and expects the Sample.Generators IIncrementalGenerator to run; Roslyn
       only loads the analyzer if Sample.Generators.dll is on disk. Sample.App references the
       generator via <ProjectReference OutputItemType="Analyzer"/>, so building Sample.App
       transitively builds Sample.Domain + Sample.Generators. ReferenceOutputAssembly=false keeps
       the fixture's Exe/analyzer outputs out of the test project's link/asset graph.
       SetConfiguration=Debug pins the fixture build to Debug regardless of the test project's
       own configuration: RoslynIndexer opens Sample.sln via MSBuildWorkspace.Create() with no
       global properties, which defaults the workspace to Debug, so the analyzer DLL must always
       end up under bin/Debug/... or `dotnet test -c Release` would still leave Roslyn looking
       in the wrong place. -->
  <ItemGroup>
    <ProjectReference Include="..\fixtures\Sample.App\Sample.App.csproj"
                      ReferenceOutputAssembly="false"
                      Private="false"
                      PrivateAssets="all"
                      SetConfiguration="Configuration=Debug" />
    <!-- XAML fixtures: built so RoslynIndexer can open the .sln via MSBuildWorkspace. Same shape
         as the Sample.App reference above (build dependency only — no asset / link / runtime). -->
    <ProjectReference Include="..\fixtures\SampleWpf\SampleWpf.csproj"
                      ReferenceOutputAssembly="false"
                      Private="false"
                      PrivateAssets="all"
                      SetConfiguration="Configuration=Debug" />
    <ProjectReference Include="..\fixtures\SampleAvalonia\SampleAvalonia.csproj"
                      ReferenceOutputAssembly="false"
                      Private="false"
                      PrivateAssets="all"
                      SetConfiguration="Configuration=Debug" />
    <!-- PartialFailure fixture: Good.csproj is restored + built so MSBuildWorkspace can
         evaluate it cleanly. Broken.csproj is deliberately NOT referenced here — its
         unresolvable PackageReference would fail the test project's build. The
         PartialFailure tests open the .sln via MSBuildWorkspace at runtime; OpenSolutionAsync
         tolerates Broken's evaluation failure (it's emitted as a WorkspaceFailed event, not
         an exception) and the per-project compilation probe in RoslynIndexer attributes
         the failure to ProjectFailure(Broken, …). -->
    <ProjectReference Include="..\fixtures\PartialFailure\Good\Good.csproj"
                      ReferenceOutputAssembly="false"
                      Private="false"
                      PrivateAssets="all"
                      SetConfiguration="Configuration=Debug" />
  </ItemGroup>

  <!-- MSBuildLocator requires that Microsoft.Build.* assemblies are not loaded from the project's
       output dir; instead they're resolved at runtime from the SDK install. Mirror the dance the
       Indexing/Server projects do so test runs of RoslynIndexer.IndexSolutionOnceAsync work. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Build" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Build.Framework" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Build.Tasks.Core" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Build.Utilities.Core" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="System.Security.Cryptography.Xml" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

</Project>
