<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Sample.Domain\Sample.Domain.csproj" />
    <!-- Wire the in-tree generator as an analyzer so Roslyn loads it during build/index. -->
    <ProjectReference Include="..\Sample.Generators\Sample.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- Privacy-boundary canaries. Roslyn loads these during project evaluation; the indexer
         must remove them from its sanitized Solution before compilation or analyzer input. -->
    <AdditionalFiles Include="PatientData\Secret.additional.txt" />
    <EditorConfigFiles Include="PatientData\Secret.editorconfig" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
