<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      Indexing-only fixture. The XAML files are walked by the XAML indexer; the C# files are
      walked by Roslyn so the cross-language `code-behind` edge has a real C# target. Targeting
      net10.0 (rather than net10.0-windows + UseWPF=true) so the fixture builds on macOS / Linux
      CI without pulling in PresentationFramework. The XAML compiler is not invoked — these files
      are not meant to render at runtime, only to index.
    -->
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>SampleWpf</RootNamespace>
    <Nullable>enable</Nullable>
    <!--
      Keep the raw Roslyn workspace identical to the privacy-sanitized semantic workspace.
      This fixture tests repository inputs, so it deliberately opts out of SDK-authored source
      and analyzer-config inputs instead of trusting spoofable obj paths or generated filenames.
    -->
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <GenerateMSBuildEditorConfigFile>false</GenerateMSBuildEditorConfigFile>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <AnalysisLevel>none</AnalysisLevel>
    <!-- Defeat the parent Directory.Build.props warning-as-error so the partial-class fixtures
         (which deliberately omit the markup-compiler's .g.cs half) don't fail the test build. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

</Project>
