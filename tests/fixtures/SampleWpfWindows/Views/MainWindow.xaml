<Window x:Class="SampleWpfWindows.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SampleWpfWindows.ViewModels"
        Title="WPF analysis fixture"
        Width="480"
        Height="240">
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>
    <StackPanel Margin="24">
        <TextBox x:Name="QueryTextBox"
                 Text="{Binding QueryText, UpdateSourceTrigger=PropertyChanged}" />
        <Button x:Name="RunButton"
                Margin="0,16,0,0"
                Style="{StaticResource PrimaryButtonStyle}"
                Command="{Binding RunCommand}"
                Click="OnRunClick"
                Content="Run" />
        <TextBlock Margin="0,16,0,0"
                   Text="{Binding Status}" />
        <TextBlock x:Name="MissingBinding"
                   Text="{Binding DoesNotExist}" />
    </StackPanel>
</Window>
