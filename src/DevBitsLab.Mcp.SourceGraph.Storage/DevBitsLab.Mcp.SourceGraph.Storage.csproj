<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="Dapper" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />

    <!-- sqlite-vec native extension (vec0). Ships native vec0.{dylib,dll,so} for every supported
         RID; we LoadExtension("vec0") at connection-open time. -->
    <PackageReference Include="sqlite-vec" />

    <ProjectReference Include="..\DevBitsLab.Mcp.SourceGraph.Core\DevBitsLab.Mcp.SourceGraph.Core.csproj" />
    <!-- For KebabCaseValidator (used by ScopeConfigLoader's `language` field validation). -->
    <ProjectReference Include="..\DevBitsLab.Mcp.SourceGraph.Sdk\DevBitsLab.Mcp.SourceGraph.Sdk.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Views.sql is the parametrised view-layer DDL loaded by Views.cs at static-init time.
         Resource id is "DevBitsLab.Mcp.SourceGraph.Storage.Views.sql" (default namespace +
         filename). See openspec/changes/add-graph-query/design.md Decision 2. -->
    <EmbeddedResource Include="Views.sql" />
  </ItemGroup>

</Project>
