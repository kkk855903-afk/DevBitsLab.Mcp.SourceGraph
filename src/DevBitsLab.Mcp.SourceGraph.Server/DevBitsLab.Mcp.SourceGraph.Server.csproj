<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>sourcegraph-mcp</AssemblyName>
    <RootNamespace>DevBitsLab.Mcp.SourceGraph.Server</RootNamespace>

    <!-- dotnet tool packaging -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>sourcegraph-mcp</ToolCommandName>
    <PackageId>DevBitsLab.Mcp.SourceGraph.Tool</PackageId>
    <Version>0.6.1</Version>
    <Description>Live code source graph MCP server for .NET solutions. Indexes C#/Roslyn into SQLite + FTS5 and exposes graph queries (find_definition, find_references, list_callers, neighborhood, impact_of_change, find_diagnostics, list_generated_files, list_tests_for, who_authored, recent_changes, ...) over stdio MCP. Watches the filesystem for incremental updates. v0.4 adds optional code-aware semantic_search backed by ONNX embeddings + sqlite-vec (gated behind --no-embeddings), Roslyn diagnostics indexing, source-generator document tracking, test-method discrimination + Tests edges, and per-symbol git blame history.</Description>
    <Authors>DevBitsLab</Authors>
    <PackageTags>mcp;roslyn;code-graph;source-graph;claude;cursor;agent</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>

    <!-- NuGet listing metadata -->
    <PackageProjectUrl>https://github.com/Jak3b0/DevBitsLab.Mcp.SourceGraph</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Jak3b0/DevBitsLab.Mcp.SourceGraph.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <ProjectReference Include="..\DevBitsLab.Mcp.SourceGraph.Core\DevBitsLab.Mcp.SourceGraph.Core.csproj" />
    <ProjectReference Include="..\DevBitsLab.Mcp.SourceGraph.Storage\DevBitsLab.Mcp.SourceGraph.Storage.csproj" />
    <ProjectReference Include="..\DevBitsLab.Mcp.SourceGraph.Indexing\DevBitsLab.Mcp.SourceGraph.Indexing.csproj" />
    <ProjectReference Include="..\DevBitsLab.Mcp.SourceGraph.Watcher\DevBitsLab.Mcp.SourceGraph.Watcher.csproj" />
    <ProjectReference Include="..\DevBitsLab.Mcp.SourceGraph.Embeddings\DevBitsLab.Mcp.SourceGraph.Embeddings.csproj" />
    <ProjectReference Include="..\DevBitsLab.Mcp.SourceGraph.Sdk\DevBitsLab.Mcp.SourceGraph.Sdk.csproj" />
  </ItemGroup>

  <!-- See note in Indexing.csproj: MSBuildLocator requires these be ExcludeAssets=runtime. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Build" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Build.Framework" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Build.Tasks.Core" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Build.Utilities.Core" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="System.Security.Cryptography.Xml" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

</Project>
