{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devbitslab.example/sourcegraph-mcp/benchmark-golden.schema.json",
  "title": "SourceGraph MCP benchmark golden tasks",
  "type": "object",
  "required": ["version", "tasks"],
  "properties": {
    "version": { "const": 1 },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "kind"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "kind": {
            "enum": ["definition", "search", "references", "implementations", "edge-kind", "semantic", "path"]
          },
          "query": { "type": "string" },
          "symbol": { "type": "string", "description": "Prefer an exact canonical key." },
          "from": { "type": "string", "description": "Path source; prefer an exact canonical key." },
          "to": { "type": "string", "description": "Path target; prefer an exact canonical key." },
          "relations": { "type": "array", "items": { "type": "string" } },
          "expected_canonical_keys": { "type": "array", "items": { "type": "string" } },
          "minResults": { "type": "integer", "minimum": 0, "default": 1 },
          "minHops": { "type": "integer", "minimum": 0, "default": 0 },
          "maxDepth": { "type": "integer", "minimum": 1, "maximum": 32, "default": 8 },
          "topK": { "type": "integer", "minimum": 1, "maximum": 1000, "default": 10 },
          "minRecall": { "type": "number", "minimum": 0, "maximum": 1, "default": 1 },
          "maxLatencyMs": { "type": "number", "exclusiveMinimum": 0 },
          "maxResponseBytes": { "type": "integer", "minimum": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
