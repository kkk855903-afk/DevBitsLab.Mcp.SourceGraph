<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- MCP -->
    <PackageVersion Include="ModelContextProtocol" Version="1.2.0" />
    <PackageVersion Include="ModelContextProtocol.Core" Version="1.2.0" />

    <!-- Hosting & logging -->
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.10" />

    <!-- Storage -->
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.10" />
    <!-- Microsoft.Data.Sqlite currently allows SQLitePCLRaw 2.1.11+, whose bundled native
         SQLite is vulnerable. Pin the compatible 3.x bundle so restore resolves SourceGear's
         patched SQLite payload instead of SQLitePCLRaw.lib.e_sqlite3 2.1.11. -->
    <PackageVersion Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.4" />
    <PackageVersion Include="Dapper" Version="2.1.72" />

    <!-- Roslyn -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.6.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="5.6.0" />
    <PackageVersion Include="Microsoft.Build.Locator" Version="1.11.2" />
    <!-- MSBuild assemblies must be ExcludeAssets=runtime PrivateAssets=all per MSBuildLocator -->
    <PackageVersion Include="Microsoft.Build" Version="18.4.0" />
    <PackageVersion Include="Microsoft.Build.Framework" Version="18.4.0" />
    <PackageVersion Include="Microsoft.Build.Tasks.Core" Version="18.4.0" />
    <PackageVersion Include="Microsoft.Build.Utilities.Core" Version="18.4.0" />
    <!-- Pin patched System.Security.Cryptography.Xml to ensure a non-vulnerable version is used even if older versions are introduced transitively by MSBuild/Roslyn-related dependencies -->
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="10.0.10" />

    <!-- CLI -->
    <PackageVersion Include="System.CommandLine" Version="2.0.7" />
    <PackageVersion Include="Tomlyn" Version="2.10.1" />

    <!-- Embeddings: ONNX Runtime + Microsoft.Extensions.AI abstraction + tokenizer library.
         Microsoft.ML.Tokenizers covers BPE (RoBERTa-style, used by Jina v2 base code and most
         modern code-aware embedding models) and WordPiece (BERT) from one API surface — the
         original FastBertTokenizer choice was BERT-only and quietly excluded the entire
         RoBERTa tier; see openspec/changes/migrate-to-ml-tokenizers/ for the swap rationale.
         The vector store native binding ships native vec0.{dylib,dll,so} via a runtimes/
         payload that flows into bin/.../runtimes/{rid}/native via the SDK. -->
    <PackageVersion Include="Microsoft.ML.OnnxRuntime" Version="1.25.1" />
    <PackageVersion Include="Microsoft.Extensions.AI.Abstractions" Version="10.5.2" />
    <PackageVersion Include="Microsoft.ML.Tokenizers" Version="2.0.0" />
    <PackageVersion Include="sqlite-vec" Version="0.1.7-alpha.2.1" />

    <!-- Tree-sitter native bindings + bundled grammars. TreeSitter.DotNet ships libtree-sitter
         plus 28+ language grammars (JavaScript, TypeScript, TSX, Python, Go, Rust, …) as native
         binaries for Windows (x86/x64/arm64), Linux (x86/x64/arm/arm64), macOS (x64/arm64). The
         host indexer wraps the package's Language / Parser / Tree API; per-language plugins
         consume bundled grammars by name (e.g. new Language("TypeScript")). -->
    <PackageVersion Include="TreeSitter.DotNet" Version="1.3.0" />

    <!-- Native ABI extraction. Keep the managed bindings and native parser on the same LLVM
         release line so sizes, calling conventions, and cursor kinds remain target-stable. -->
    <PackageVersion Include="ClangSharp" Version="21.1.8.4" />
    <PackageVersion Include="libclang" Version="21.1.8" />

    <!-- Protobuf contracts are compiled by the official protoc binary and projected from its
         descriptor set. Grpc.Tools supplies the pinned compiler payload; Google.Protobuf supplies
         the descriptor/reflection model consumed by the indexer. -->
    <PackageVersion Include="Grpc.Tools" Version="2.82.0" />
    <PackageVersion Include="Google.Protobuf" Version="3.35.1" />

    <!-- Tests -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.5.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="Xunit.SkippableFact" Version="1.5.23" />
    <PackageVersion Include="FluentAssertions" Version="8.9.0" />
    <PackageVersion Include="coverlet.collector" Version="10.0.0" />

    <!-- Build / packaging -->
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.203" />

    <!-- Benchmarks -->
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
  </ItemGroup>
</Project>
